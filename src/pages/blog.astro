---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const formatDate = (date) => new Intl.DateTimeFormat("en-GB").format(date);

const getPostActivityTime = (post) => post.data.updatedDate?.getTime() ?? post.data.pubDate.getTime();

const posts = (await getCollection("blog")).sort((a, b) => {
	const activityDifference = getPostActivityTime(b) - getPostActivityTime(a);

	if (activityDifference !== 0) {
		return activityDifference;
	}

	const pubDateDifference = b.data.pubDate.getTime() - a.data.pubDate.getTime();

	if (pubDateDifference !== 0) {
		return pubDateDifference;
	}

	return a.data.title.localeCompare(b.data.title);
});
---

<Layout title="Blog | Gabriel Marinho" description="Posts, notes, and articles by Gabriel Marinho.">
	<main class="blog-page">
		<p class="recent-posts">Recent posts</p>

		<section class="post-list">
			{posts.length === 0 ? (
				<p class="empty-state">No posts published yet.</p>
			) : (
				<ul>
					{posts.map((post) => (
						<li class="post-card">
							<a class="post-link" href={`/post/${post.id}`}>
								<span>{post.data.title}</span>
								<p>
									{post.data.description}
								</p>
							</a>
						</li>
					))}
				</ul>
			)}
		</section>
	</main>
</Layout>

<style>
	.blog-page {
		display: grid;
		gap: 2rem;
	}

	.recent-posts {
		margin-top: 14px;
		margin-bottom: 0;
	}

	.post-list ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.post-card {
		padding: 7px 11px;
		border-radius: 8px;
		background: #fff;
		cursor: pointer;
	}

	.post-card:hover {
		outline: 1px solid #ebebeb;
	}

	.post-link {
		display: block;
		color: inherit;
		text-decoration: none;
		transition: none;
	}

	.post-link span {
		margin: 0;
		color: #181818;
	}

	.post-link p {
		margin: 0;
		font-size: 13px;
		color: #787878;
	}

	.empty-state {
		color: #787878;
	}
</style>