---
import ThemeToggle from "./ThemeToggle.astro";

const { pathname } = Astro.url;

const normalizePath = (value: string) => value.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
    return normalizePath(pathname) === normalizePath(href);
};
---
<header>
    <div class="profile">
        <a href="/" class="name">Gabriel Marinho</a>
        <span class="role">Software Engineer</span>
    </div>

    <ul>
        <li><a href="/about" class:list={["menu-link", { active: isActive("/about") }]}>About</a></li>
        <li><a href="/blog" class:list={["menu-link", { active: isActive("/blog") }]}>Blog</a></li>
        <li><a href="/uses" class:list={["menu-link", { active: isActive("/uses") }]}>Uses</a></li>
        <li><a href="/contact" class:list={["menu-link", { active: isActive("/contact") }]}>Contact</a></li>
        <li class="theme-item"><ThemeToggle /></li>
    </ul>
</header>

<style>
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    ul {
        list-style-type: none;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.25rem 0.65rem;
        margin: 0;
        padding: 0;
    }

    li {
        cursor: pointer;
        padding: 0;
    }

    .theme-item {
        display: flex;
        align-items: center;
    }

    .profile {
        display: flex;
        flex-direction: column;
    }

    .name {
        color: inherit;
        text-decoration: none;
        font-weight: 500;
    }

    .role {
        color: var(--color-muted);
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    .menu-link.active {
        color: var(--color-text);
    }

    @media (max-width: 520px) {
        header {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.65rem;
        }

        ul {
            width: 100%;
            justify-content: space-between;
            gap: 0.5rem;
        }
    }
</style>
