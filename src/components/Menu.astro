---
import ThemeToggle from "./ThemeToggle.astro";

const { pathname } = Astro.url;

const normalizePath = (value: string) => value.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
	if (href === "/blog" && pathname.startsWith("/post/")) {
		return true;
	}
	return normalizePath(pathname) === normalizePath(href);
};
---

<header class="site-header">
	<div class="top-bar">
		<div class="profile">
			<a href="/" class="name">Gabriel Marinho</a>
			<span class="role">Software Engineer</span>
		</div>

		<div class="nav-wrapper">
			<nav class="desktop-nav" aria-label="Primary navigation">
				<ul>
					<li>
						<a
							href="/about"
							class:list={[
								"menu-link",
								{ active: isActive("/about") },
							]}>About</a
						>
					</li>
					<li>
						<a
							href="/blog"
							class:list={[
								"menu-link",
								{ active: isActive("/blog") },
							]}>Blog</a
						>
					</li>
					<li>
						<a
							href="/uses"
							class:list={[
								"menu-link",
								{ active: isActive("/uses") },
							]}>Uses</a
						>
					</li>
					<li>
						<a
							href="/contact"
							class:list={[
								"menu-link",
								{ active: isActive("/contact") },
							]}>Contact</a
						>
					</li>
				</ul>
			</nav>

			<div class="header-actions">
				<ThemeToggle />
				<button
					id="mobile-menu-toggle"
					type="button"
					class="mobile-menu-toggle"
					aria-label="Open navigation menu"
					aria-expanded="false"
					aria-controls="mobile-nav"
				>
					<span class="bar"></span>
					<span class="bar"></span>
				</button>
			</div>
		</div>
	</div>

	<nav
		id="mobile-nav"
		class="mobile-nav"
		aria-label="Mobile navigation"
		aria-hidden="true"
	>
		<div class="mobile-nav-inner">
			<ul>
				<li>
					<a
						href="/"
						class:list={[
							"mobile-link",
							{ active: isActive("/") },
						]}
					>
						<span>Home</span>
						<span class="indicator" aria-hidden="true"></span>
					</a>
				</li>
				<li>
					<a
						href="/about"
						class:list={[
							"mobile-link",
							{ active: isActive("/about") },
						]}
					>
						<span>About</span>
						<span class="indicator" aria-hidden="true"></span>
					</a>
				</li>
				<li>
					<a
						href="/blog"
						class:list={[
							"mobile-link",
							{ active: isActive("/blog") },
						]}
					>
						<span>Blog</span>
						<span class="indicator" aria-hidden="true"></span>
					</a>
				</li>
				<li>
					<a
						href="/uses"
						class:list={[
							"mobile-link",
							{ active: isActive("/uses") },
						]}
					>
						<span>Uses</span>
						<span class="indicator" aria-hidden="true"></span>
					</a>
				</li>
				<li>
					<a
						href="/contact"
						class:list={[
							"mobile-link",
							{ active: isActive("/contact") },
						]}
					>
						<span>Contact</span>
						<span class="indicator" aria-hidden="true"></span>
					</a>
				</li>
			</ul>
		</div>
	</nav>
</header>

<script>
	const initMobileMenu = () => {
		const toggleBtn = document.getElementById("mobile-menu-toggle");
		const mobileNav = document.getElementById("mobile-nav");
		if (!toggleBtn || !mobileNav) return;

		const setMenuState = (isOpen: boolean) => {
			toggleBtn.setAttribute("aria-expanded", String(isOpen));
			toggleBtn.setAttribute(
				"aria-label",
				isOpen ? "Close navigation menu" : "Open navigation menu"
			);
			mobileNav.setAttribute("aria-hidden", String(!isOpen));
			mobileNav.classList.toggle("open", isOpen);
			toggleBtn.classList.toggle("open", isOpen);
		};

		toggleBtn.addEventListener("click", (event) => {
			event.stopPropagation();
			const isExpanded =
				toggleBtn.getAttribute("aria-expanded") === "true";
			setMenuState(!isExpanded);
		});

		document.addEventListener("click", (event) => {
			const target = event.target as Node | null;
			if (
				mobileNav.classList.contains("open") &&
				target &&
				!mobileNav.contains(target) &&
				!toggleBtn.contains(target)
			) {
				setMenuState(false);
			}
		});

		document.addEventListener("keydown", (event) => {
			if (
				event.key === "Escape" &&
				mobileNav.classList.contains("open")
			) {
				setMenuState(false);
				toggleBtn.focus();
			}
		});

		window.addEventListener("resize", () => {
			if (
				window.innerWidth > 600 &&
				mobileNav.classList.contains("open")
			) {
				setMenuState(false);
			}
		});
	};

	initMobileMenu();
	document.addEventListener("astro:after-swap", initMobileMenu);
</script>

<style>
	.site-header {
		margin-bottom: 1.5rem;
	}

	.top-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
	}

	.profile {
		display: flex;
		flex-direction: column;
	}

	.name {
		color: inherit;
		text-decoration: none;
		font-weight: 500;
	}

	.role {
		color: var(--color-muted);
	}

	.nav-wrapper {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.desktop-nav ul {
		list-style-type: none;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		padding: 0;
	}

	.desktop-nav li {
		cursor: pointer;
		padding: 0;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.menu-link.active {
		color: var(--color-text);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.mobile-menu-toggle {
		display: none;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		width: 18px;
		height: 18px;
		cursor: pointer;
		color: var(--color-muted);
		flex-direction: column;
		justify-content: center;
		align-items: flex-end;
		gap: 5px;
		transition: color 0.2s ease-in-out;
		-webkit-tap-highlight-color: transparent;
	}

	.mobile-menu-toggle:hover,
	.mobile-menu-toggle.open {
		color: var(--color-text);
	}

	.mobile-menu-toggle:focus-visible {
		outline: 1px solid var(--color-border);
		border-radius: 4px;
	}

	.mobile-menu-toggle .bar {
		display: block;
		width: 16px;
		height: 1.5px;
		background-color: currentColor;
		border-radius: 2px;
		transition:
			transform 0.2s ease-in-out,
			width 0.2s ease-in-out;
		transform-origin: center;
	}

	.mobile-menu-toggle .bar:last-child {
		width: 11px;
	}

	.mobile-menu-toggle.open .bar:first-child {
		width: 16px;
		transform: translateY(3.25px) rotate(45deg);
	}

	.mobile-menu-toggle.open .bar:last-child {
		width: 16px;
		transform: translateY(-3.25px) rotate(-45deg);
	}

	.mobile-nav {
		display: none;
		grid-template-rows: 0fr;
		opacity: 0;
		transition:
			grid-template-rows 0.22s ease,
			opacity 0.18s ease,
			margin-top 0.22s ease;
		margin-top: 0;
	}

	.mobile-nav.open {
		grid-template-rows: 1fr;
		opacity: 1;
		margin-top: 0.85rem;
	}

	.mobile-nav-inner {
		overflow: hidden;
	}

	.mobile-nav ul {
		list-style: none;
		margin: 0;
		padding: 0.35rem;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		background-color: var(--color-surface);
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.mobile-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 0.75rem;
		border-radius: 7px;
		font-size: 14px;
		color: var(--color-muted);
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
		-webkit-tap-highlight-color: transparent;
	}

	.mobile-link:hover,
	.mobile-link:active {
		background-color: var(--color-surface-hover);
		color: var(--color-text);
	}

	.mobile-link.active {
		color: var(--color-text);
		background-color: var(--color-surface-hover);
		font-weight: 500;
	}

	.indicator {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background-color: transparent;
		transition: background-color 0.15s ease;
	}

	.mobile-link.active .indicator {
		background-color: var(--color-text);
	}

	@media (max-width: 600px) {
		.desktop-nav {
			display: none;
		}

		.mobile-menu-toggle {
			display: inline-flex;
		}

		.mobile-nav {
			display: grid;
		}
	}
</style>
